  "authentication": {
    "login": {
      "sub-title": {
        "text-1": "wherever you roam,",
        "text-2": "marks your home"
      },
      "form": {
        "email-input": {
          "label": "Email address"
        },
        "password-input": {
          "label": "Password"
        },
        "submit-btn": "Sign in",
        "errors": {
          "UAA_AUTH_UNAU_ERR_1": "Invalid credentials. Please try again.",
          "UAA_AUTH_FORB_ERR_4": "Your account is not yet validated. Please follow email instructions.",
          "UAA_AUTH_FORB_ERR_6": "You account is disabled. Please contact the support team.",
          "undefined": "Something went wrong at our end, and we are working to fix the problem! "
        }
      },
      "forgot-password-link": "Forgot your password?"
    },
    "forgot-password": {
      "title": "Forgot your password?",
      "sub-title": "Enter your email below and we will send you a reset link",
      "form": {
        "email-input": {
          "label": "Email address"
        },
        "submit-btn": "Send",
        "errors": {
          "undefined": "Something went wrong at our end, and we are working to fix the problem! "
        },
        "success": "If an account with this email exists, you will receive a password reset link shortly. Please check your inbox (and spam folder)."
      },
      "login-link": "Go back to login page"
    },
    "reset-password": {
      "title": "Reset your password",
      "sub-title": "Set a new password for your account by entering and confirming it below.",
      "form": {
        "password-input": {
          "placeholder": "Password",
          "errors": {
            "strong": "Password should be at least 8 characters long lower and upper case, with a number and a special character"
          }
        },
        "confirm-password-input": {
          "placeholder": "Confirm your password",
          "errors": {
            "mismatch": "Passwords do not match"
          }
        },
        "submit-btn": "Submit",
        "errors": {
          "undefined": "Something went wrong at our end, and we are working to fix the problem! ",
          "UAA_RNF_ERR_3": "We couldn’t verify your reset request. The key might be incorrect.",
          "UAA_AUTH_FORB_ERR_5": "The reset key has expired. A new password reset email has been sent to your registered email address."
        },
        "success": "Your password has been updated! You can now sign in with your new credentials."
      },
      "login-link": "Go back to login page",
      "errors": {
        "no-token": "The reset password link is invalid or missing the required token."
      }
    },
    "account-validation": {
      "title": "Validate your account",
      "sub-title": "Set a password for your account by entering and confirming it below.",
      "form": {
        "password-input": {
          "placeholder": "Password",
          "errors": {
            "strong": "Password should be at least 8 characters long lower and upper case, with a number and a special character"
          }
        },
        "confirm-password-input": {
          "placeholder": "Confirm your password",
          "errors": {
            "mismatch": "Passwords do not match"
          }
        },
        "submit-btn": "Submit",
        "errors": {
          "undefined": "Something went wrong at our end, and we are working to fix the problem! ",
          "UAA_RNF_ERR_3": "We couldn’t verify your account validation request. The key might be incorrect.",
          "UAA_AUTH_FORB_ERR_5": "The account validation key has expired. A new account validation email has been sent to your registered email address."
        },
        "success": "Your account has been validated! You can now sign in with your credentials."
      },
      "login-link": "Go back to login page",
      "errors": {
        "no-token": "The account validation link is invalid or missing the required token."
      }
    }
  },
